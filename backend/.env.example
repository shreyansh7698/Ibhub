PROJECT_NAME="IBHub Backend"
DEBUG=True

# Signs all session tokens (admin + applicant). Generate a long random value
# in production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

DATABASE_URL=sqlite:///./app.db

# Public URL of the deployed frontend. Used to (a) build password-reset
# links and (b) as the allowed CORS origin in production.
FRONTEND_URL=http://localhost:5173

# Seeds the single initial admin account on first startup only. After that,
# the admin should use "Forgot password" on the admin login page to rotate
# this — changing these env vars later has no effect on an existing admin.
ADMIN_EMAIL=admin@theibhub.com
ADMIN_PASSWORD=ibhub-demo

ADMIN_TOKEN_EXPIRE_MINUTES=480
USER_TOKEN_EXPIRE_MINUTES=480
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP (used to send password-reset emails). If left blank, emails are
# printed to the backend console instead -- fine for local development,
# never acceptable in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True

# File uploads
MAX_UPLOAD_SIZE_MB=12
UPLOAD_DIR=uploads/documents

# Razorpay. Leave both blank to run in sandbox mode (payment status still
# comes from the client's declared outcome). Set both to enable real order
# creation and cryptographic signature verification.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
